# Copy to .env.local (git-ignored).
#
# `npm run dev` starts Vite + FastAPI (not Express). DATABASE_URL is required to
# boot FastAPI. Everything else fails lazily at call time.
#
# Verified: with the first blocks set, `npm run dev` serves the UI on / (200) —
# only the /api/* data routes 500 if the database or a given integration is missing.

# ── Required to boot ────────────────────────────────────────────────────────
# Matches docker-compose.yml. Host port is 5433 to avoid colliding with a local
# Postgres install.
DATABASE_URL="postgresql://snapsync:snapsync@localhost:5433/snapsync"

# Optional workspace-catalogue cache. `npm run dev` starts compose Redis and
# defaults this if unset. Leave empty to force Postgres-only.
REDIS_URL="redis://127.0.0.1:6379/0"

# Any non-empty string satisfies the constructor; a real key is only needed when
# you actually invoke an AI feature.
AI_INTEGRATIONS_OPENAI_API_KEY="sk-dummy-local"

# ── Skip auth locally ───────────────────────────────────────────────────────
# Bypasses Clerk on BOTH sides — every request runs as the fixed user
# "dev_local_user". Both vars are needed; the VITE_ one is read by the browser
# bundle. Never set these in production.
DEV_BYPASS_AUTH="true"
VITE_DEV_BYPASS_AUTH="true"

# ── API origin (leave unset until Railway cutover) ──────────────────────────
# Unset: SPA fetches stay relative `/api` (local Vite proxy). At cutover, set
# this on the Vercel SPA build only:
# VITE_API_ORIGIN="https://api.snapsyncai.co.uk"

# ── Optional: fill in only the features you're working on ───────────────────
# Without these the app runs; the specific feature 500s when you invoke it.

# Real AI listing generation — replace the dummy key above with a real one.
AI_INTEGRATIONS_OPENAI_BASE_URL=""

# Image uploads — no local substitute, uses the real bucket
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Real Clerk auth instead of the bypass above
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
VITE_CLERK_PUBLISHABLE_KEY=""

# Subscriptions and checkout
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Shopify connect / publish
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,write_products,read_inventory,write_inventory,read_locations"
APP_BASE_URL="http://localhost:5001"
CONNECTION_ENCRYPTION_KEY=""
