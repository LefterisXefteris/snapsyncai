# Copy to .env.local (git-ignored).
#
# `npm run dev` starts Vite + FastAPI (not Express). DATABASE_URL is required to
# boot FastAPI. Everything else fails lazily at call time.
#
# Verified: with the first blocks set, `npm run dev` serves the UI on / (200) —
# only the /api/* data routes 500 if the database or a given integration is missing.

# ── Required to boot ────────────────────────────────────────────────────────
# Local CLI Postgres from `npx supabase start` (scripts/dev.sh runs that).
# Production DATABASE_URL is the cloud project's Session pooler (:5432) and
# belongs on Railway only — never here.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Optional workspace-catalogue cache. `npm run dev` starts compose Redis and
# defaults this if unset. Leave empty to force Postgres-only.
REDIS_URL="redis://127.0.0.1:6379/0"

# Any non-empty string satisfies the constructor; a real key is only needed when
# you actually invoke an AI feature.
AI_INTEGRATIONS_OPENAI_API_KEY="sk-dummy-local"

# Listing copy refresh and Bulk SEO. Unset = Start stays blocked.
# DataForSEO: login and password from https://app.dataforseo.com/api-access
# SEARCH_DEMAND_URL="https://api.dataforseo.com/v3/keywords_data/google_ads/keywords_for_keywords/live"
SEARCH_DEMAND_LOGIN=""
SEARCH_DEMAND_API_KEY=""
SEARCH_DEMAND_URL=""

# ── Skip auth locally ───────────────────────────────────────────────────────
# Bypasses Clerk on BOTH sides — every request runs as the fixed user
# "dev_local_user". Both vars are needed; the VITE_ one is read by the browser
# bundle. Never set these in production.
DEV_BYPASS_AUTH="true"
VITE_DEV_BYPASS_AUTH="true"

# ── API origin (leave unset until Railway cutover) ──────────────────────────
# Unset: SPA fetches stay relative `/api` (local Vite proxy). At cutover, set
# this on the Vercel SPA build only:
# VITE_API_ORIGIN="https://api.snapsyncai.co.uk"

# ── Optional: fill in only the features you're working on ───────────────────
# Without these the app runs; the specific feature 500s when you invoke it.

# Real AI listing generation — replace the dummy key above with a real one.
AI_INTEGRATIONS_OPENAI_BASE_URL=""

# Image uploads — local CLI Storage (`npx supabase start`), not the production
# project. These JWT values are the published local demo keys, not secrets.
# Production bucket is `product-images`.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"
SUPABASE_STORAGE_BUCKET="product-images"

# Real Clerk auth instead of the bypass above
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
VITE_CLERK_PUBLISHABLE_KEY=""

# Subscriptions and checkout
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Shopify connect / publish
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,write_products,read_inventory,write_inventory,read_locations,read_publications,write_publications"
APP_BASE_URL="http://localhost:5001"
CONNECTION_ENCRYPTION_KEY=""
