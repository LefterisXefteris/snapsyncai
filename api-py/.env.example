# Required. Local: `npx supabase start` → 127.0.0.1:54322. Production: Session
# pooler (:5432) of the cloud project, set on Railway, never in .env.local.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Optional. Unset = catalogue always reads Postgres. Local compose Redis:
# REDIS_URL="redis://127.0.0.1:6379/0"

# Core
ENVIRONMENT="development"
PORT=8000
APP_BASE_URL="http://localhost:5001"
SENTRY_DSN=""

# Required once the SPA calls https://api.snapsyncai.co.uk from www.
# CORS_ALLOW_ORIGINS="https://www.snapsyncai.co.uk,https://snapsyncai.co.uk"

# Auth — skip Clerk for local work. FastAPI refuses this flag when ENVIRONMENT=production.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
DEV_BYPASS_AUTH=true

# Storage — local CLI (`npx supabase start`), not production.
# These JWT values are the published local demo keys, not secrets.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"
SUPABASE_STORAGE_BUCKET="product-images"

# Billing
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI
AI_INTEGRATIONS_OPENAI_API_KEY=""
AI_INTEGRATIONS_OPENAI_BASE_URL=""

# Search demand — listing copy refresh is blocked until this is set.
SEARCH_DEMAND_API_KEY=""
SEARCH_DEMAND_URL=""

# Shopify
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,write_products,read_inventory,write_inventory,read_locations,read_publications,write_publications"
CONNECTION_ENCRYPTION_KEY=""
