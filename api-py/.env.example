# Required
DATABASE_URL="postgresql://user:pass@host:6543/postgres"

# Optional. Unset = catalogue always reads Postgres. Local compose Redis:
# REDIS_URL="redis://127.0.0.1:6379/0"

# Core
ENVIRONMENT="development"
PORT=8000
APP_BASE_URL="http://localhost:5001"
SENTRY_DSN=""

# Required once the SPA calls https://api.snapsyncai.co.uk from www.
# CORS_ALLOW_ORIGINS="https://www.snapsyncai.co.uk,https://snapsyncai.co.uk"

# Auth — skip Clerk for local work. FastAPI refuses this flag when ENVIRONMENT=production.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
DEV_BYPASS_AUTH=true

# Storage
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Billing
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI
AI_INTEGRATIONS_OPENAI_API_KEY=""
AI_INTEGRATIONS_OPENAI_BASE_URL=""

# Shopify
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,write_products,read_inventory,write_inventory,read_locations"
CONNECTION_ENCRYPTION_KEY=""
